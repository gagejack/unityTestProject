# Normalize text in Git; preserve binary assets exactly.
* text=auto
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.shader text eol=lf
*.uss text eol=lf
*.uxml text eol=lf
*.inputactions text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.fbx binary
*.blend binary
*.glb binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.ttf binary
*.otf binary
