=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="1340" height="150" as="geometry"/></mxCell></object><object label="&lt;b&gt;Canvas&lt;/b&gt;&lt;br&gt;Stamina Bar: StaminaBar [Movement]" tooltip=""  id="scn-canvas"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="scn-g-ui"><mxGeometry x="30" y="40" width="250" height="90" as="geometry"/></mxCell></object><object label="&lt;b&gt;Speed HUD&lt;/b&gt;&lt;br&gt;SpeedReadout [Movement]" tooltip=""  id="scn-speed"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="scn-g-ui"><mxGeometry x="310" y="40" width="250" height="90" as="geometry"/></mxCell></object><object label="&lt;b&gt;Pixel Debug Menu UI&lt;/b&gt;&lt;br&gt;UIDocument — the F1 menu&lt;br&gt;(layout PixelDebugMenu.uxml)" tooltip=""  id="scn-f1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="scn-g-ui"><mxGeometry x="590" y="40" width="250" height="90" as="geometry"/></mxCell></object><object label="&lt;b&gt;UIDocument&lt;/b&gt;&lt;br&gt;The deprecated F2 menu&lt;br&gt;(layout GameUI.uxml)" tooltip=""  id="scn-f2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="scn-g-ui"><mxGeometry x="870" y="40" width="250" height="90" as="geometry"/></mxCell></object><object label="&lt;b&gt;EventSystem&lt;/b&gt;&lt;br&gt;Unity UI input" tooltip=""  id="scn-events"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="scn-g-ui"><mxGeometry x="1150" y="40" width="170" height="90" as="geometry"/></mxCell></object><object label="Test tools" tooltip=""  id="scn-g-tools"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1340" height="120" as="geometry"/></mxCell></object><object label="&lt;b&gt;Test Area Tools&lt;/b&gt;&lt;br&gt;TestAreaControls, DamagePopups [Test areas]&lt;br&gt;Child: Start TA-Start (TestStartMarker)" tooltip=""  id="scn-tat"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="scn-g-tools"><mxGeometry x="30" y="40" width="420" height="90" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram name="3 Plan a feature" id="tpl"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object label="&lt;b&gt;How to plan a new feature&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Duplicate this page (right-click the page tab, Duplicate) and rename it to your feature.&lt;br&gt;2. Keep the green dashed boxes you need, delete the rest, and add more by copying a box.&lt;br&gt;3. For each box: type what it does inside it. Select it and press Ctrl+M (Edit Data) to fill in &lt;i&gt;does&lt;/i&gt;, &lt;i&gt;systems_touched&lt;/i&gt;, &lt;i&gt;core_contract&lt;/i&gt; and &lt;i&gt;test&lt;/i&gt;.&lt;br&gt;4. Draw arrows for what triggers what. Use &lt;b&gt;amber dashed&lt;/b&gt; boxes for existing things that must change.&lt;br&gt;5. Save (Ctrl+S), then tell Claude: &quot;implement the planned boxes on page &lt;your page name&gt; in docs/flow/game-map.drawio&quot;.&lt;br&gt;&lt;br&gt;Claude turns it into a proposal in docs/STATUS.md, builds the smallest playable slice, and when done changes the boxes from green dashed to blue solid." tooltip=""  id="tpl-how"><mxCell style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;strokeColor=#cccccc;fillColor=#ffffff;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="200" as="geometry"/></mxCell></object><object label="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;What starts it? (a key, a hit, a pickup...)" tooltip="" status="planned" does="" systems_touched="" core_contract="" test="" id="tpl-input"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;strokeWidth=2;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="240" height="90" as="geometry"/></mxCell></object><object label="&lt;b&gt;Rule&lt;/b&gt;&lt;br&gt;The new script or state that decides what happens" tooltip="" status="planned" does="" systems_touched="" core_contract="" test="" id="tpl-rule"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;strokeWidth=2;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="340" y="290" width="240" height="90" as="geometry"/></mxCell></object><object label="&lt;b&gt;Data&lt;/b&gt;&lt;br&gt;Numbers or content kept in a ScriptableObject asset" tooltip="" status="planned" does="" systems_touched="" core_contract="" test="" id="tpl-data"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;strokeWidth=2;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="340" y="450" width="240" height="90" as="geometry"/></mxCell></object><object label="&lt;b&gt;Result&lt;/b&gt;&lt;br&gt;What the player sees, hears or feels" tooltip="" status="planned" does="" systems_touched="" core_contract="" test="" id="tpl-result"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;strokeWidth=2;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="640" y="290" width="240" height="90" as="geometry"/></mxCell></object><object label="&lt;b&gt;Existing system to change&lt;/b&gt;&lt;br&gt;(amber = already built, needs an edit)" tooltip="" status="changing" does="" systems_touched="" core_contract="" test="" id="tpl-existing"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;strokeWidth=2;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="640" y="450" width="240" height="90" as="geometry"/></mxCell></object><object label="&lt;b&gt;Test station&lt;/b&gt;&lt;br&gt;Where you will try it in Play mode" tooltip="" status="planned" does="" systems_touched="" core_contract="" test="" id="tpl-station"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;strokeWidth=2;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="940" y="290" width="240" height="90" as="geometry"/></mxCell></object><mxCell id="tpl-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#808080;endArrow=block;endFill=1;" edge="1" parent="1" source="tpl-input" target="tpl-rule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tpl-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#808080;endArrow=block;endFill=1;" edge="1" parent="1" source="tpl-data" target="tpl-rule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tpl-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#808080;endArrow=block;endFill=1;" edge="1" parent="1" source="tpl-rule" target="tpl-result"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tpl-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#808080;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="tpl-rule" target="tpl-existing"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tpl-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#808080;endArrow=block;endFill=1;" edge="1" parent="1" source="tpl-result" target="tpl-station"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>